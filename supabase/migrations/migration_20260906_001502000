-- PROFILES
create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  name text not null default '',
  role text not null default 'visiteur' check (role in ('admin','gestionnaire','employe','client','visiteur')),
  discount_percent numeric not null default 0,
  created_at timestamptz not null default now()
);

-- SCIERIES
create table if not exists public.sawmills (
  id text primary key,
  name text not null,
  tax_rate numeric not null default 0.15,
  citizenship_septims numeric not null default 0,
  citizenship_charcoal numeric not null default 0
);

-- PRODUITS
create table if not exists public.products (
  id text primary key,
  name text not null,
  sale_price numeric not null default 0,
  buyback_price numeric not null default 0,
  sellable boolean not null default true,
  buyable boolean not null default true,
  sort_order int not null default 0
);

-- FICHES CLIENTS
create table if not exists public.client_entries (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  discount_percent numeric not null default 0,
  note text,
  created_at timestamptz not null default now()
);

-- STOCKS DES MEMBRES
create table if not exists public.member_stocks (
  id uuid primary key default gen_random_uuid(),
  member_id uuid not null references public.profiles(id) on delete cascade,
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  product_id text not null references public.products(id) on delete cascade,
  quantity numeric not null default 0,
  unique (member_id, sawmill_id, product_id)
);

-- DEMANDES DE DEPOT / RETRAIT
create table if not exists public.stock_requests (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  member_id uuid not null references public.profiles(id) on delete cascade,
  product_id text not null references public.products(id) on delete cascade,
  quantity numeric not null default 0,
  type text not null check (type in ('depot','retrait')),
  status text not null default 'pending' check (status in ('pending','validated','rejected')),
  created_by uuid not null,
  created_at timestamptz not null default now(),
  validated_by uuid,
  validated_at timestamptz,
  note text
);

-- RACHATS
create table if not exists public.purchases (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  member_id uuid not null references public.profiles(id) on delete cascade,
  product_id text not null references public.products(id) on delete cascade,
  quantity numeric not null default 0,
  unit_price numeric not null default 0,
  total numeric not null default 0,
  created_by uuid not null,
  created_at timestamptz not null default now()
);

-- VENTES
create table if not exists public.sales (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  sold_by uuid not null,
  client_label text,
  discount_percent numeric not null default 0,
  status text not null default 'pending' check (status in ('pending','validated','rejected')),
  validated_by uuid,
  validated_at timestamptz,
  total numeric not null default 0,
  created_at timestamptz not null default now(),
  note text
);

create table if not exists public.sale_lines (
  id uuid primary key default gen_random_uuid(),
  sale_id uuid not null references public.sales(id) on delete cascade,
  member_id uuid not null references public.profiles(id) on delete cascade,
  product_id text not null references public.products(id) on delete cascade,
  quantity numeric not null default 0,
  unit_price numeric not null default 0,
  total numeric not null default 0,
  from_stock boolean not null default true
);

-- DETTES
create table if not exists public.debts (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  debtor_id uuid not null references public.profiles(id) on delete cascade,
  creditor_id uuid not null references public.profiles(id) on delete cascade,
  amount numeric not null default 0,
  sale_id uuid not null,
  product_id text,
  quantity numeric,
  status text not null default 'open' check (status in ('open','settled')),
  created_at timestamptz not null default now(),
  settled_at timestamptz,
  settled_by uuid
);

-- COMMANDES CLIENTS
create table if not exists public.orders (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  client_id uuid not null references public.profiles(id) on delete cascade,
  client_entry_id uuid,
  items jsonb not null default '[]',
  discount_percent numeric not null default 0,
  total numeric not null default 0,
  pickup_time text,
  delivery_note text,
  status text not null default 'new' check (status in ('new','taken','done')),
  created_at timestamptz not null default now()
);

-- TAXES HEBDOMADAIRES
create table if not exists public.settlements (
  id uuid primary key default gen_random_uuid(),
  sawmill_id text not null references public.sawmills(id) on delete cascade,
  member_id uuid not null references public.profiles(id) on delete cascade,
  week_start date not null,
  tax_amount numeric not null default 0,
  citizenship_septims numeric not null default 0,
  citizenship_charcoal numeric not null default 0,
  total_due numeric not null default 0,
  paid boolean not null default false,
  paid_at timestamptz,
  validated_by uuid,
  unique (sawmill_id, member_id, week_start)
);

