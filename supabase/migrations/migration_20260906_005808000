alter table public.profiles add column if not exists sawmill_access text not null default 'both' check (sawmill_access in ('rivebois','penombris','both'));

create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.profiles (id, name, email, role, requested_role, sawmill_access)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'name', split_part(new.email, '@', 1)),
    new.email,
    case when (select count(*) from public.profiles) = 0 then 'admin' else 'pending' end,
    coalesce(new.raw_user_meta_data->>'requested_role', 'visiteur'),
    case when (select count(*) from public.profiles) = 0 then 'both' else coalesce(new.raw_user_meta_data->>'sawmill_access', 'both') end
  )
  on conflict (id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();