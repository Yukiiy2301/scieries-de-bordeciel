create table if not exists public.stock_request_lines (
  id uuid primary key default gen_random_uuid(),
  request_id uuid not null references public.stock_requests(id) on delete cascade,
  product_id text not null references public.products(id) on delete cascade,
  quantity numeric not null default 0
);

alter table public.stock_request_lines enable row level security;
create policy "stock_request_lines_select" on public.stock_request_lines for select to authenticated using (true);
create policy "stock_request_lines_insert" on public.stock_request_lines for insert to authenticated with check (public.is_staff());
create policy "stock_request_lines_delete" on public.stock_request_lines for delete to authenticated using (public.is_admin() or public.is_gestionnaire());

ALTER TABLE public.stock_requests ALTER COLUMN product_id DROP NOT NULL;
ALTER TABLE public.stock_requests ALTER COLUMN quantity DROP NOT NULL;

ALTER PUBLICATION supabase_realtime ADD TABLE public.stock_request_lines;