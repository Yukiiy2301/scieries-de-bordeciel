alter table public.profiles add column if not exists client_entry_id uuid;
alter table public.profiles add column if not exists pending_entry_id uuid;

create or replace function public.self_entry()
returns uuid
language sql
stable
security definer
set search_path = public
as $$
  select client_entry_id from public.profiles where id = auth.uid();
$$;

-- Un client ne peut pas s'auto-attribuer une fiche : seul le chef lie la fiche validée
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.profiles (id, name, email, role, requested_role, sawmill_access)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'name', split_part(new.email, '@', 1)),
    new.email,
    case when (select count(*) from public.profiles) = 0 then 'admin' else 'pending' end,
    coalesce(new.raw_user_meta_data->>'requested_role', 'visiteur'),
    case when (select count(*) from public.profiles) = 0 then 'both' else coalesce(new.raw_user_meta_data->>'sawmill_access', 'both') end
  )
  on conflict (id) do nothing;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

drop policy if exists profiles_update on public.profiles;
create policy "profiles_update" on public.profiles for update to authenticated
  using (id = auth.uid() or public.is_admin())
  with check (public.is_admin() or (id = auth.uid() and role = public.current_role() and discount_percent = public.self_discount() and client_entry_id is not distinct from public.self_entry()));